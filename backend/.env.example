MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_BASE64_MB=45
MINIMAX_ENABLE_FILES_API=false
MINIMAX_FILE_PURPOSE=vision
MAX_UPLOAD_MB=500
UPLOAD_DIR=./storage/uploads
RESULT_DIR=./storage/results
DATABASE_PATH=./storage/jobs.sqlite
MAX_CONCURRENT_JOBS=1
JOB_RETENTION_HOURS=72
MINIMAX_REQUEST_TIMEOUT_SECONDS=180
MINIMAX_REPAIR_JSON=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
